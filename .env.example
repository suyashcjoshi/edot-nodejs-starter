# Where the data goes — your Elastic project's OTLP ingest URL
OTEL_EXPORTER_OTLP_ENDPOINT=https://<your-project>.ingest.<region>.elastic.cloud:443

# Proves it is you — carries the API key
OTEL_EXPORTER_OTLP_HEADERS=Authorization=ApiKey <your-api-key>

# The name Kibana shows under Observability → Services
OTEL_SERVICE_NAME=edot-nodejs-starter

# Optional labels on all data, such as version and environment
OTEL_RESOURCE_ATTRIBUTES=service.version=1.0.0,deployment.environment.name=dev

# Sends pino logs to Elastic — off by default, set to true to enable
ELASTIC_OTEL_NODE_ENABLE_LOG_SENDING=true
