# EDOT / OpenTelemetry connection — copy this file to .env and fill in your values
# Get these from: Elastic Cloud → your deployment → Integrations → OpenTelemetry

# Your Elastic OTLP ingest endpoint (no trailing slash)
OTEL_EXPORTER_OTLP_ENDPOINT=https://your-deployment.apm.us-east-1.aws.elastic.cloud

# API key in the format: Authorization=ApiKey <base64-encoded-key>
OTEL_EXPORTER_OTLP_HEADERS=Authorization=ApiKey your-api-key-here

# Name that appears in the Elastic Observability UI (Kibana → Observability → Services)
OTEL_SERVICE_NAME=hello-edot-node

# Optional: tag the service with version and environment
OTEL_RESOURCE_ATTRIBUTES=service.version=1.0.0,deployment.environment.name=dev
